# Fastlane Environment Configuration
# ======================================
# قم بتحديث هذه القيم بمعلومات حسابك

# معرف التطبيق (Bundle Identifier)
APP_IDENTIFIER=com.muein.orders

# البريد الإلكتروني لحساب Apple Developer
APPLE_ID=heshamkoptan@email.com

# App Store Connect Team ID (من App Store Connect)
ITC_TEAM_ID=5493DS73C7

# Developer Portal Team ID (من Apple Developer Portal)
TEAM_ID=5493DS73C7

# ======================================
# App Store Connect API Key
# ======================================
# للحصول على هذه القيم:
# 1. اذهب إلى https://appstoreconnect.apple.com
# 2. Users and Access → Integrations
# 3. انقر على + لإنشاء مفتاح جديد
# 4. حمل ملف .p8 (يُحمل مرة واحدة فقط)

# Key ID (مثال: G2L6LRG5PK)
APP_STORE_CONNECT_KEY_ID=G2L6LRG5PK

# Issuer ID
APP_STORE_CONNECT_ISSUER_ID=487919a3-70a5-4992-af37-d75eb388c881    

# مسار ملف .p8 (نسبي إلى ios/fastlane/)
APP_STORE_CONNECT_KEY_PATH=./AuthKey_G2L6LRG5PK.p8
