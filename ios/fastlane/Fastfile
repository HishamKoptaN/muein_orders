default_platform(:ios)

platform :ios do
  lane :generate_profile do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "api_private_key.p8",
      duration: 1200,
      in_house: false
    )
    get_certificates(type: "distribution")
sigh(
      app_identifier: "com.muein.orders",
      readonly: false
      adhoc: false,
      development: false
    )
  end
end