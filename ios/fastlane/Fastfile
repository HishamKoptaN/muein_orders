default_platform(:ios)

platform :ios do
  desc "Push a new release build to TestFlight or build IPA with automatic code signing"
  lane :build_signed_ipa do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_PRIVATE_KEY"], 
    )
    get_provisioning_profile(
      app_identifier: "com.muein.orders",
      distribution_type: "app-store"     
    )
    UI.message("Fastlane setup and certificate verification completed successfully!")
  end
end
