default_platform(:ios)

platform :ios do
  lane :generate_profile do
    # 1. الاتصال بحساب أبل عبر الـ API
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "api_private_key.p8",
      duration: 1200,
      in_house: false
    )

    # 2. البحث عن شهادة توزيع صالحة وتحميلها إن وجدت، مع منع توليد واحدة جديدة تلقائياً
    begin
      get_certificates(
        readonly: true, # البحث في حساب أبل دون محاولة إنشاء شهادة جديدة
        output_path: "./certs"
      )
    rescue => e
      UI.important("لم يتم العثور على شهادة محلية، سيتم محاولة استخدام الشهادة المتاحة على الحساب...")
      get_certificates(
        readonly: false,
        generate_apple_certs: false,
        skip_international: true
      )
    end

    # 3. إنشاء وتنزيل البروفايل
    sigh(
      app_identifier: "com.muein.orders",
      readonly: false,
      filename: "com.muein.orders AppStore"
    )
  end
end