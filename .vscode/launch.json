{
  "version": "0.3.0",
  "configurations": [
    /* ================= DEV ================= */

    {
      "name": "Flutter Dev (Android)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": ["--flavor", "dev", "--dart-define=ENV=dev"]
