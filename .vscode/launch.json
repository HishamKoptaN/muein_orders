{
  "version": "0.2.0",
  "configurations": [
    /* ================= DEV ================= */

    {
      "name": "Flutter Dev (Android)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_dev.dart",
      "args": ["--flavor", "dev"],
      "deviceId": "android"
    },
    {
      "name": "Flutter Dev (Web)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_dev.dart",
      "deviceId": "web-server",
      "args": ["--flavor", "dev", "--web-port", "3000"]
    },

    /* ================= PROD ================= */

    {
      "name": "Flutter Prod (Android)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_prod.dart",
      "args": ["--flavor", "prod"],
      "deviceId": "android"
    },
    {
      "name": "Flutter Prod (Web)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main_prod.dart",
      "deviceId": "web-server",
      "args": ["--flavor", "prod", "--web-port", "4000"]
    }
  ]
}
