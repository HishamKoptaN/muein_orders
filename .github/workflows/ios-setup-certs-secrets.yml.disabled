name: iOS Setup Certificates (Secrets)
on:
  workflow_call:
    secrets:
      IOS_CERTIFICATE_BASE64:
        required: false
      IOS_CERTIFICATE_PASSWORD:
        required: false
      IOS_PROVISIONING_PROFILE_BASE64:
        required: true
    outputs:
      provisioning_profile_uuid:
        description: "Provisioning Profile UUID"
        value: ${{ jobs.setup.outputs.provisioning_profile_uuid }}

jobs:
  setup:
    runs-on: macos-latest
    outputs:
      provisioning_profile_uuid: ${{ steps.certs.outputs.provisioning_profile_uuid }}
    steps:
      - uses: actions/checkout@v4

      - name: 🔧 Install Certificates from Secrets
        id: certs
        run: |
          echo "🔧 Installing iOS certificates from Secrets..."

          # Create keychain
          KEYCHAIN_NAME="build.keychain"
          KEYCHAIN_PASSWORD="temp123"
          security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_NAME"
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_NAME"
          security set-keychain-settings -t 3600 "$KEYCHAIN_NAME"
          security list-keychains -d user -s "$KEYCHAIN_NAME" \
            $(security list-keychains -d user | tr -d '"')

          # Install Certificate from Secret
          if [ -n "${{ secrets.IOS_CERTIFICATE_BASE64 }}" ]; then
            echo "📜 Installing certificate from Secret..."
            echo "${{ secrets.IOS_CERTIFICATE_BASE64 }}" | base64 --decode > /tmp/certificate.p12
            P12_PASSWORD="${{ secrets.IOS_CERTIFICATE_PASSWORD || '123456' }}"
            security import /tmp/certificate.p12 -k "$KEYCHAIN_NAME" \
              -P "$P12_PASSWORD" -T /usr/bin/codesign || true
            security set-key-partition-list -S apple-tool:,apple: \
              -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN_NAME" || true
            echo "✅ Certificate installed"
          else
            echo "⚠️ IOS_CERTIFICATE_BASE64 not set"
          fi

          # Install Provisioning Profile from Secret
          if [ -n "${{ secrets.IOS_PROVISIONING_PROFILE_BASE64 }}" ]; then
            echo "📋 Installing provisioning profile from Secret..."
            mkdir -p ~/Library/MobileDevice/Provisioning\ Profiles
            echo "${{ secrets.IOS_PROVISIONING_PROFILE_BASE64 }}" | base64 --decode > \
              ~/Library/MobileDevice/Provisioning\ Profiles/build_profile.mobileprovision

            # Extract UUID
            PP_UUID=$(/usr/libexec/PlistBuddy -c 'Print UUID' /dev/stdin <<< \
              "$(security cms -D -i ~/Library/MobileDevice/Provisioning\ Profiles/build_profile.mobileprovision)")
            echo "📋 UUID: $PP_UUID"
            echo "provisioning_profile_uuid=$PP_UUID" >> $GITHUB_OUTPUT
            echo "✅ Provisioning profile installed"
          else
            echo "❌ IOS_PROVISIONING_PROFILE_BASE64 not set!"
            exit 1
          fi

