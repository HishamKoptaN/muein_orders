name: iOS Setup API Key (Secrets)
on:
  workflow_call:
    secrets:
      APP_STORE_CONNECT_API_KEY_BASE64:
        required: true
      APP_STORE_CONNECT_KEY_ID:
        required: true
      APP_STORE_CONNECT_ISSUER_ID:
        required: true
    outputs:
      api_key_path:
        description: "API Key Path"
        value: ${{ jobs.setup.outputs.api_key_path }}
      key_id:
        description: "Key ID"
        value: ${{ jobs.setup.outputs.key_id }}
      issuer_id:
        description: "Issuer ID"
        value: ${{ jobs.setup.outputs.issuer_id }}

jobs:
  setup:
    runs-on: macos-latest
    outputs:
      api_key_path: ${{ steps.apikey.outputs.api_key_path }}
      key_id: ${{ steps.apikey.outputs.key_id }}
      issuer_id: ${{ steps.apikey.outputs.issuer_id }}
    env:
      KEY_ID: ${{ secrets.APP_STORE_CONNECT_KEY_ID }}
      ISSUER_ID: ${{ secrets.APP_STORE_CONNECT_ISSUER_ID }}
    steps:
      - uses: actions/checkout@v4

      - name: 🔐 Setup App Store Connect API Key from Secrets
        id: apikey
        run: |
          echo "🔐 إعداد App Store Connect API Key from Secrets..."

          # Verify secrets exist
          if [ -z "${{ secrets.APP_STORE_CONNECT_API_KEY_BASE64 }}" ]; then
            echo "❌ APP_STORE_CONNECT_API_KEY_BASE64 not set!"
            exit 1
          fi
          if [ -z "$ISSUER_ID" ]; then
            echo "❌ APP_STORE_CONNECT_ISSUER_ID not set!"
            exit 1
          fi
          if [ -z "$KEY_ID" ]; then
            echo "❌ APP_STORE_CONNECT_KEY_ID not set!"
            exit 1
          fi

          # Decode and setup API Key
          mkdir -p ~/private_keys
          echo "${{ secrets.APP_STORE_CONNECT_API_KEY_BASE64 }}" | base64 --decode > \
            ~/private_keys/AuthKey_${KEY_ID}.p8

          echo "api_key_path=$HOME/private_keys/AuthKey_${KEY_ID}.p8" >> $GITHUB_OUTPUT
          echo "key_id=${KEY_ID}" >> $GITHUB_OUTPUT
          echo "issuer_id=${ISSUER_ID}" >> $GITHUB_OUTPUT
          echo "✅ API Key configured"

