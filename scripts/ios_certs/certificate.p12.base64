# iOS Distribution Certificate - Base64 Encoded
# العبارة التالية هي القيمة المشفرة لملف distribution.p12
# يمكن إنشاؤه من distribution.pem + private_key باستخدام:
# openssl pkcs12 -export -out certificate.p12 -inkey private_key -in distribution.pem

# قم بلصق القيمة هنا بعد تشغيل الأمر:
# [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("G:\project_assets\muein\prod\ios\certificate.p12")) | Set-Clipboard

# ثم أضفها كـ GitHub Secret: IOS_CERTIFICATE_BASE64

